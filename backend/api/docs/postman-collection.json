{
  "info": {
    "name": "MTRX Pay API - Day 4",
    "description": "Merchant onboarding API endpoints for MTRX Pay platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "merchantId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"merchant@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"fullName\": \"John Smith\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"merchant@example.com\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Merchants",
      "item": [
        {
          "name": "Create Merchant Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('merchantId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legalBusinessName\": \"Acme Corporation Ltd\",\n  \"tradingName\": \"Acme Corp\",\n  \"businessType\": \"limited_company\",\n  \"countryOfIncorporation\": \"United Kingdom\",\n  \"registrationNumber\": \"12345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/merchants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "merchants"]
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"Merchant profile created\",\n  \"data\": {\n    \"id\": \"uuid-here\",\n    \"legal_business_name\": \"Acme Corporation Ltd\",\n    \"trading_name\": \"Acme Corp\",\n    \"business_type\": \"limited_company\",\n    \"country_of_incorporation\": \"United Kingdom\",\n    \"registration_number\": \"12345678\",\n    \"status\": \"draft\",\n    \"created_at\": \"2026-03-18T12:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "Validation Error",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"Validation failed\",\n  \"errors\": {\n    \"legalBusinessName\": \"Required\",\n    \"businessType\": \"Must be one of: sole_trader, limited_company, llp, partnership, plc\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get My Merchant Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/merchants/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "merchants", "me"]
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid-here\",\n    \"legal_business_name\": \"Acme Corporation Ltd\",\n    \"trading_name\": \"Acme Corp\",\n    \"business_type\": \"limited_company\",\n    \"country_of_incorporation\": \"United Kingdom\",\n    \"registration_number\": \"12345678\",\n    \"industry_type\": \"technology\",\n    \"status\": \"draft\",\n    \"created_at\": \"2026-03-18T12:00:00.000Z\",\n    \"updated_at\": \"2026-03-18T12:00:00.000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Update Merchant Profile",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tradingName\": \"Acme Corp Updated\",\n  \"industryType\": \"technology\",\n  \"businessDescription\": \"Software development and consulting services\",\n  \"websiteUrl\": \"https://acme.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/merchants/{{merchantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "merchants", "{{merchantId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Get Full Onboarding Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/{{merchantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "onboarding", "{{merchantId}}"]
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"merchant\": { \"id\": \"uuid\", \"legal_business_name\": \"Acme Corp\" },\n    \"progress\": {\n      \"currentStep\": \"documents\",\n      \"completionPercent\": 80,\n      \"canSubmit\": false,\n      \"missingItems\": [\"Business Registration document\"]\n    },\n    \"owners\": [],\n    \"documents\": []\n  }\n}"
            }
          ]
        },
        {
          "name": "Save Business Details",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"industryType\": \"technology\",\n  \"businessDescription\": \"Software development and consulting services\",\n  \"websiteUrl\": \"https://acme.com\",\n  \"expectedMonthlyVolume\": \"10000-50000\",\n  \"expectedTransactionCount\": \"100-500\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/{{merchantId}}/business-details",
              "host": ["{{baseUrl}}"],
              "path": ["api", "onboarding", "{{merchantId}}", "business-details"]
            }
          },
          "response": []
        },
        {
          "name": "Get Progress",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/{{merchantId}}/progress",
              "host": ["{{baseUrl}}"],
              "path": ["api", "onboarding", "{{merchantId}}", "progress"]
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"merchantId\": \"uuid-here\",\n    \"currentStep\": \"documents\",\n    \"completionPercent\": 80,\n    \"canSubmit\": false,\n    \"isSubmitted\": false,\n    \"missingItems\": [\"Business Registration document\"],\n    \"sectionDetails\": {\n      \"account\": { \"complete\": true, \"label\": \"Account Created\" },\n      \"profile\": { \"complete\": true, \"label\": \"Merchant Profile\" },\n      \"address\": { \"complete\": true, \"label\": \"Business Address\" },\n      \"owners\": { \"complete\": true, \"label\": \"Owners & Directors\" },\n      \"documents\": { \"complete\": false, \"label\": \"Documents\", \"missing\": [\"Business Registration document\"] },\n      \"submitted\": { \"complete\": false, \"label\": \"Submitted for Review\" }\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Validate Submission",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/{{merchantId}}/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "onboarding", "{{merchantId}}", "validate"]
            }
          },
          "response": [
            {
              "name": "Valid",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"valid\": true,\n    \"errors\": []\n  }\n}"
            },
            {
              "name": "Invalid",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"valid\": false,\n    \"errors\": [\n      { \"field\": \"documents\", \"message\": \"Missing required document: ID Proof\" },\n      { \"field\": \"owners\", \"message\": \"At least one beneficial owner required\" }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Submit for Review",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/{{merchantId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "onboarding", "{{merchantId}}", "submit"]
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Onboarding submitted for review\",\n  \"data\": {\n    \"merchantId\": \"uuid-here\",\n    \"status\": \"under_review\",\n    \"submittedAt\": \"2026-03-18T12:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "Validation Failed",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"message\": \"Submission validation failed\",\n  \"errors\": [\n    { \"field\": \"documents\", \"message\": \"Missing required document: ID Proof\" }\n  ]\n}"
            }
          ]
        }
      ]
    },
